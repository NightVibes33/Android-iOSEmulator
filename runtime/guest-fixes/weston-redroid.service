[Unit]
Description=Weston display for Android iOSEmulator
After=systemd-udev-settle.service seatd.service
Wants=seatd.service
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment=HOME=/root
Environment=XDG_RUNTIME_DIR=/run/weston
Environment=LIBSEAT_BACKEND=seatd
ExecStartPre=/usr/bin/mkdir -p /run/weston
ExecStartPre=/usr/bin/chmod 0700 /run/weston
ExecStartPre=/bin/sh -c 'count=0; while [ ! -e /dev/dri/card0 ] && [ "$count" -lt 120 ]; do count=$((count + 1)); sleep 1; done; [ -e /dev/dri/card0 ]'
ExecStart=/usr/bin/weston --backend=drm-backend.so --idle-time=0 --config=/etc/xdg/weston/weston.ini
Restart=on-failure
RestartSec=2
TimeoutStartSec=0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=graphical.target
